  { value: 9, label: 'October' },
  { value: 10, label: 'November' },
  { value: 11, label: 'December' },
];

// Generate years for the dropdown (current year and previous 4 years)
const YEARS = Array.from({ length: 5 }, (_, i: number) => new Date().getFullYear() - i);

export default function HealthDashboardPage() {
  // State hooks - keep these at the top of the component
  const [viewMode, setViewMode] = useState<ViewMode>('classic');
  const [query, setQuery] = useState('');
  const [onlyNeuro, setOnlyNeuro] = useState(true);
  const [selectedYear, setSelectedYear] = useState<number>(new Date().getFullYear());
  const [selectedMonth, setSelectedMonth] = useState<number | null>(null);
  const [mounted, setMounted] = useState(false);

  // Set mounted state after component mounts
  useEffect(() => {
    setMounted(true);
  }, []);

  // Show loading state until component is mounted
  if (!mounted) {
    return (
      <div className="flex items-center justify-center h-screen">
        <div className="text-gray-500">Loading dashboard...</div>
      </div>
    );
  }
    { name: 'Dr. A. Nguyen', role: 'Pediatrician' },
  ],
};

const CAREGIVER = {
  name: 'Maria Alvarez',
  relation: 'Mother / Caregiver',
  access: 'Caregiver access (read-only summary)',
};

const SUMMARY = {
  stability: 'Watch closely',
  lastUpdated: 'Today, 8:12 PM',
  redFlags: ['New severe headache', 'Confusion or speech changes', 'Seizure activity'],
};

// Helper function to generate historical dates
const generateHistoricalDates = (startYear: number, endYear: number) => {
  const now = new Date();
  const currentYear = now.getFullYear();
  const currentMonth = now.getMonth();
  
  return Array.from({ length: (endYear - startYear + 1) * 12 }, (_, i) => {
    const year = startYear + Math.floor(i / 12);
    const month = i % 12;
    return { year, month };
  }).filter(({ year, month }) => {
    if (year > currentYear) return false;
    if (year === currentYear && month > currentMonth) return false;
    return true;
  });
};

// Move months array outside the component
const MONTHS = [
  { value: 0, label: 'January' },
  { value: 1, label: 'February' },
  { value: 2, label: 'March' },
  { value: 3, label: 'April' },
  { value: 4, label: 'May' },
  { value: 5, label: 'June' },
  { value: 6, label: 'July' },
  { value: 7, label: 'August' },
  { value: 8, label: 'September' },
  { value: 9, label: 'October' },
  { value: 10, label: 'November' },
  { value: 11, label: 'December' },
];

// Generate years for the dropdown (current year and previous 4 years)
const YEARS = Array.from({ length: 5 }, (_, i: number) => new Date().getFullYear() - i);

export default function HealthDashboardPage() {
  // State hooks - keep these at the top of the component
  const [viewMode, setViewMode] = useState<ViewMode>('classic');
  const [query, setQuery] = useState('');
  const [onlyNeuro, setOnlyNeuro] = useState(true);
  const [selectedYear, setSelectedYear] = useState<number>(new Date().getFullYear());
  const [selectedMonth, setSelectedMonth] = useState<number | null>(null);
  const [mounted, setMounted] = useState(false);

  // Set mounted state after component mounts
  useEffect(() => {
    setMounted(true);
  }, []);

  // Show loading state until component is mounted
  if (!mounted) {
    return (
      <div className="flex items-center justify-center h-screen">
        <div className="text-gray-500">Loading dashboard...</div>
      </div>
    );
  }
    { value: 10, label: 'November' },
    { value: 11, label: 'December' },
  ], []);

  const generateHistoricalData = () => {
    const historicalDates = generateHistoricalDates(2022, 2026);
    const allMedications: any[] = [];
    const allAppointments: any[] = [];
    const allLabs: any[] = [];
    const allIncidents: any[] = [];

    const meds = [
      { name: 'Prednisone', status: 'Active', dose: '10mg', schedule: 'Once daily', indication: 'Inflammation', tag: 'neuro' },
      { name: 'Ibuprofen', status: 'As needed', dose: '200mg', schedule: 'Every 6-8 hours', indication: 'Pain/Fever', tag: 'general' },
      { name: 'Acetaminophen', status: 'As needed', dose: '325mg', schedule: 'Every 4-6 hours', indication: 'Pain/Fever', tag: 'general' },
      { name: 'Amitriptyline', status: 'Active', dose: '25mg', schedule: 'At bedtime', indication: 'Migraine prevention', tag: 'neuro' },
    ];

    const appointmentTypes = [
      { 
        type: 'Neurology Follow-up', 
        with: 'Dr. S. Patel', 
        location: 'Children\'s Hospital, Main Campus', 
        tag: 'neuro',
        prep: 'Fast for 4 hours before appointment'
      },
      { 
        type: 'Pediatric Check-up', 
        with: 'Dr. A. Nguyen', 
        location: 'Pediatric Associates', 
        tag: 'general',
        prep: 'Bring insurance card and medication list'
      },
      { 
        type: 'MRI Scan', 
        with: 'Radiology Dept', 
        location: 'Imaging Center', 
        tag: 'neuro',
        prep: 'No metal objects, arrive 30 minutes early'
      },
      { 
        type: 'EEG Test', 
        with: 'Neurology Dept', 
        location: 'Children\'s Hospital', 
        tag: 'neuro',
        prep: 'Wash hair night before, no hair products'
      },
      { 
        type: 'Physical Therapy', 
        with: 'PT Specialist', 
        location: 'Rehabilitation Center', 
        tag: 'general',
        prep: 'Wear comfortable clothing'
      },
      { 
        type: 'Cardiology Check-up', 
        with: 'Dr. M. Chen', 
        location: 'Heart Center', 
        tag: 'cardio',
        prep: 'Bring recent test results'
      },
      { 
        type: 'Blood Work', 
        with: 'Lab Services', 
        location: 'LabCorp', 
        tag: 'general',
        prep: 'Fast for 8-12 hours before test'
      },
    ];

    const labTests = [
      { name: 'CRP', range: '0.0–5.0', tag: 'neuro' },
      { name: 'ESR', range: '0–15', tag: 'neuro' },
      { name: 'CBC', range: '—', tag: 'general' },
      { name: 'CMP', range: '—', tag: 'general' },
      { name: 'Vitamin D', range: '30-100 ng/mL', tag: 'general' },
      { name: 'Troponin', range: '0-0.04 ng/mL', tag: 'cardio' },
      { name: 'BNP', range: '0-100 pg/mL', tag: 'cardio' },
      { name: 'D-Dimer', range: '0-0.5 mg/L', tag: 'neuro' },
      { name: 'Ferritin', range: '20-300 ng/mL', tag: 'general' },
      { name: 'Thyroid Panel', range: '—', tag: 'general' },
    ];

    const incidentTypes = [
      // Cardiac Events (more frequent)
      { 
        title: 'Tachycardia episode', 
        severity: 'Moderate', 
        notes: 'Heart rate spiked to 150 bpm at rest. Resolved with rest and hydration after 25 minutes. Noted pale skin and fatigue post-episode.', 
        tag: 'cardio' 
      },
      { 
        title: 'POTS-like symptoms', 
        severity: 'Moderate', 
        notes: 'Lightheadedness and heart rate increase of 40+ bpm upon standing. Lasted 10 minutes. Used salt tablets and compression.', 
        tag: 'cardio' 
      },
      { 
        title: 'Chest tightness with palpitations', 
        severity: 'Severe', 
        notes: 'Reported squeezing sensation with skipped beats. EKG showed sinus tachycardia. Required beta-blocker dose.', 
        tag: 'cardio' 
      },
      { 
        title: 'Pre-syncopal episode', 
        severity: 'Moderate', 
        notes: 'Near-fainting during morning routine. BP 85/55, HR 145. Recovered in supine position with legs elevated.', 
        tag: 'cardio' 
      },
      { 
        title: 'Exercise intolerance', 
        severity: 'Mild', 
        notes: 'Unable to complete PE class due to rapid HR and shortness of breath. HR took 30+ minutes to return to baseline.', 
        tag: 'cardio' 
      },

      // Neuroimmune Events
      { 
        title: 'Post-exertional malaise', 
        severity: 'Moderate', 
        notes: '24-48hr delayed symptom exacerbation following school field trip. Severe fatigue, brain fog, and increased HR.', 
        tag: 'neuro' 
      },
      { 
        title: 'Brain fog with word-finding difficulty', 
        severity: 'Mild', 
        notes: 'Struggled with word recall during conversation. Lasted ~2 hours. No other neurological deficits noted.', 
        tag: 'neuro' 
      },
      { 
        title: 'Autonomic storm', 
        severity: 'Severe', 
        notes: 'Episodic hypertension (150/95) with tachycardia, flushing, and agitation. Required PRN clonidine and quiet environment.', 
        tag: 'neuro' 
      },
      { 
        title: 'Temperature dysregulation', 
        severity: 'Moderate', 
        notes: 'Inability to regulate body temp - alternating between chills and sweating. Ambient temp 72°F. Resolved with cooling vest and warm blankets as needed.', 
        tag: 'neuro' 
      },
      { 
        title: 'Gastrointestinal dysmotility', 
        severity: 'Moderate', 
        notes: 'Delayed gastric emptying with nausea. Skipped breakfast due to fullness from previous night\'s dinner. Used ginger and small sips of water.', 
        tag: 'neuro' 
      },

      // General Symptoms
      { 
        title: 'Postural dizziness', 
        severity: 'Mild', 
        notes: 'Brief lightheadedness when standing. Resolved with counterpressure maneuvers. HR increased by 35 bpm.', 
        tag: 'general' 
      },
      { 
        title: 'Headache with photophobia', 
        severity: 'Moderate', 
        notes: 'Throbbing frontal headache with light sensitivity. Used FL-41 glasses and rest in dark room. Took acetaminophen with minimal relief.', 
        tag: 'general' 
      },
      { 
        title: 'Muscle weakness', 
        severity: 'Mild', 
        notes: 'Difficulty with stairs in the afternoon. Strength 4/5 in proximal muscles. Resolved after electrolyte drink and rest.', 
        tag: 'general' 
      }
    ];

    historicalDates.forEach(({ year, month }) => {
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      
      // Add medications (every 3 months)
      if (month % 3 === 0) {
        meds.forEach(med => {
          allMedications.push({
            ...med,
            startDate: new Date(year, month, Math.floor(Math.random() * daysInMonth) + 1),
            endDate: Math.random() > 0.7 ? new Date(year, month + 2, Math.floor(Math.random() * daysInMonth) + 1) : null
          });
        });
      }

      // Add appointments (1-3 per month)
      const numAppointments = 1 + Math.floor(Math.random() * 3);
      for (let i = 0; i < numAppointments; i++) {
        const type = appointmentTypes[Math.floor(Math.random() * appointmentTypes.length)];
        allAppointments.push({
          ...type,
          when: new Date(year, month, Math.floor(Math.random() * daysInMonth) + 1, 8 + Math.floor(Math.random() * 8), Math.random() > 0.5 ? 0 : 30)
        });
      }

      // Add lab tests (1-4 per month)
      const numLabs = 1 + Math.floor(Math.random() * 4);
      for (let i = 0; i < numLabs; i++) {
        const test = labTests[Math.floor(Math.random() * labTests.length)];
        let result, status;
        
        if (test.range === '—') {
          status = 'Normal';
          result = 'Within range';
        } else {
          const isHigh = Math.random() > 0.7;
          status = isHigh ? 'High' : 'Normal';
          if (test.name === 'CRP') {
            result = isHigh ? (2 + Math.random() * 15).toFixed(1) + ' mg/L' : (0.1 + Math.random() * 2).toFixed(1) + ' mg/L';
          } else if (test.name === 'ESR') {
            result = isHigh ? (16 + Math.floor(Math.random() * 30)) + ' mm/hr' : (1 + Math.floor(Math.random() * 10)) + ' mm/hr';
          } else {
            result = 'Within range';
          }
        }
        
        allLabs.push({
          ...test,
          result,
          status,
          date: new Date(year, month, Math.floor(Math.random() * daysInMonth) + 1)
        });
      }

      // Add incidents (2-8 per month)
      const numIncidents = 2 + Math.floor(Math.random() * 7);
      for (let i = 0; i < numIncidents; i++) {
        const incident = incidentTypes[Math.floor(Math.random() * incidentTypes.length)];
        allIncidents.push({
          ...incident,
          date: new Date(year, month, Math.floor(Math.random() * daysInMonth) + 1)
        });
      }
    });

    // Sort all data by date
    const sortByDate = (a: any, b: any) => new Date(b.date || b.when).getTime() - new Date(a.date || a.when).getTime();
    
    return {
      medications: allMedications.sort((a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime()),
      appointments: allAppointments.sort(sortByDate),
      labs: allLabs.sort(sortByDate),
      incidents: allIncidents.sort(sortByDate)
    };
  };

  const historicalData = useMemo(generateHistoricalData, []);

  const filterByDate = (items: any[], dateField: string) => {
    return items.filter(item => {
      const date = new Date(item[dateField] || item.when);
      if (date.getFullYear() !== selectedYear) return false;
      if (selectedMonth !== null && date.getMonth() !== selectedMonth) return false;
      return true;
    });
  };

  const medications = useMemo(() => filterByDate(historicalData.medications, 'startDate'), [historicalData.medications, selectedYear, selectedMonth]);
  const appointments = useMemo(() => filterByDate(historicalData.appointments, 'when'), [historicalData.appointments, selectedYear, selectedMonth]);
  const labs = useMemo(() => filterByDate(historicalData.labs, 'date'), [historicalData.labs, selectedYear, selectedMonth]);
  const incidents = useMemo(() => filterByDate(historicalData.incidents, 'date'), [historicalData.incidents, selectedYear, selectedMonth]);

  const filteredIncidents = useMemo(() => {
    const q = query.trim().toLowerCase();
    return incidents.filter((i) => {
      if (onlyNeuro && i.tag !== 'neuro') return false;
      if (!q) return true;
      return `${i.title} ${i.severity} ${i.notes}`.toLowerCase().includes(q);
    });
  }, [incidents, onlyNeuro, query]);

  const filteredLabs = useMemo(() => {
    const q = query.trim().toLowerCase();
    return labs.filter((l) => {
      if (onlyNeuro && l.tag !== 'neuro') return false;
      if (!q) return true;
      return `${l.name} ${l.result} ${l.status}`.toLowerCase().includes(q);
    });
  }, [labs, onlyNeuro, query]);

  const filteredMeds = useMemo(() => {
    const q = query.trim().toLowerCase();
    return medications.filter((m) => {
      if (!q) return true;
      return `${m.name} ${m.indication} ${m.dose} ${m.schedule}`.toLowerCase().includes(q);
    });
  }, [medications, query]);

  const formatDate = (date: Date | string) => {
    if (!mounted) return ''; // Return empty string during SSR
    
    const d = new Date(date);
    const now = new Date();
    const diffTime = Math.abs(now.getTime() - d.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    
    if (diffDays === 0) return 'Today';
    if (diffDays === 1) return 'Yesterday';
    if (diffDays < 7) return `${diffDays} days ago`;
    
    return d.toLocaleDateString('en-US', { 
      year: d.getFullYear() === now.getFullYear() ? undefined : 'numeric',
      month: 'short', 
      day: 'numeric' 
    });
  };

  const formatAppointmentDate = (date: Date) => {
    return date.toLocaleDateString('en-US', { 
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  };

  const classicStats = useMemo(() => {
    const activeMeds = medications.filter((m) => m.status === 'Active').length;
    const upcoming = appointments.length;
    const flaggedLabs = labs.filter((l) => l.status !== 'Normal').length;
    const neuroIncidents = incidents.filter((i) => i.tag === 'neuro').length;
    const totalIncidents = incidents.length;
    return {
      activeMeds,
      upcoming,
      flaggedLabs,
      neuroIncidents,
      totalIncidents,
    };
  }, [appointments.length, incidents, labs, medications]);

  const activityBars = useMemo(() => {
    const points = [1, 2, 4, 3, 2, 5, 3];
    const max = Math.max(...points);
    return points.map((v) => ({
      v,
      pct: Math.round((v / max) * 100),
    }));
  }, []);

  function ViewModeToggle() {
    return (
      <div className="inline-flex rounded-lg bg-white shadow-sm ring-1 ring-gray-200 p-1">
        <button
          type="button"
          onClick={() => setViewMode('classic')}
          className={
            viewMode === 'classic'
              ? 'rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white'
              : 'rounded-md px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50'
          }
        >
          Dashboard
        </button>
        <button
          type="button"
          onClick={() => setViewMode('caregiver')}
          className={
            viewMode === 'caregiver'
              ? 'rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white'
              : 'rounded-md px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50'
          }
        >
          Caregiver Summary
        </button>
      </div>
    );
  }

  function Dashboard() {
    return (
      <div className="flex-1 overflow-y-auto overscroll-contain p-6 md:p-10">
        <div className="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Health Dashboard</h1>
            <p className="mt-1 text-gray-600">
              Patient: {patient.name} (age {patient.age})
            </p>
            <p className="mt-1 text-sm text-gray-500">Primary concern: {patient.primaryConcern}</p>
          </div>

          <div className="flex flex-col gap-2 sm:flex-row sm:items-center">
            <ViewModeToggle />
            <div className="flex items-center gap-2 rounded-lg bg-white px-3 py-2 shadow-sm ring-1 ring-gray-200">
              <input
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Search..."
                className="w-full border-0 bg-transparent text-sm text-gray-900 placeholder-gray-500 focus:ring-0"
              />
            </div>
            <div className="flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm text-gray-700 shadow-sm ring-1 ring-gray-200">
              <select
                value={selectedYear}
                onChange={(e) => setSelectedYear(Number(e.target.value))}
                className="border-0 bg-transparent text-sm text-gray-900 focus:ring-0"
              >
                {years.map(year => (
                  <option key={year} value={year}>{year}</option>
                ))}
              </select>
              <select
                value={selectedMonth ?? ''}
                onChange={(e) => setSelectedMonth(e.target.value ? Number(e.target.value) : null)}
                className="border-0 bg-transparent text-sm text-gray-900 focus:ring-0"
              >
                <option value="">All Months</option>
                {months.map(month => (
                  <option key={month.value} value={month.value}>
                    {month.label}
                  </option>
                ))}
              </select>
            </div>
            <label className="flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm text-gray-700 shadow-sm ring-1 ring-gray-200">
              <input
                type="checkbox"
                checked={onlyNeuro}
                onChange={(e) => setOnlyNeuro(e.target.checked)}
                className="h-4 w-4"
              />
              Neuro focus
            </label>
          </div>
        </div>

        <div className="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <p className="text-sm font-medium text-gray-500">Incidents</p>
            <p className="mt-2 text-2xl font-bold text-gray-900">
              {onlyNeuro ? classicStats.neuroIncidents : classicStats.totalIncidents}
            </p>
            <p className="mt-1 text-sm text-gray-600">Logged recently</p>
          </div>
          <div className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <p className="text-sm font-medium text-gray-500">Flagged labs</p>
            <p className="mt-2 text-2xl font-bold text-gray-900">{classicStats.flaggedLabs}</p>
            <p className="mt-1 text-sm text-gray-600">High / abnormal results</p>
          </div>
          <div className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <p className="text-sm font-medium text-gray-500">Active meds</p>
            <p className="mt-2 text-2xl font-bold text-gray-900">{classicStats.activeMeds}</p>
            <p className="mt-1 text-sm text-gray-600">Currently prescribed</p>
          </div>
          <div className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <p className="text-sm font-medium text-gray-500">Upcoming</p>
            <p className="mt-2 text-2xl font-bold text-gray-900">{classicStats.upcoming}</p>
            <p className="mt-1 text-sm text-gray-600">Appointments</p>
          </div>
        </div>

        <div className="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200 lg:col-span-2">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Activity (last 7 days)</h2>
              <Activity className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 grid grid-cols-7 gap-2 items-end">
              {activityBars.map((b, idx) => (
                <div key={idx} className="flex flex-col items-center gap-2">
                  <div className="w-full rounded-md bg-gray-100 overflow-hidden" style={{ height: 96 }}>
                    <div className="w-full bg-indigo-500" style={{ height: `${b.pct}%` }} />
                  </div>
                  <span className="text-xs text-gray-500">D{idx + 1}</span>
                </div>
              ))}
            </div>
            <p className="mt-3 text-xs text-gray-500">Mock chart (replace with real telemetry when connected).</p>
          </section>

          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Care team</h2>
              <User className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 space-y-2">
              {patient.careTeam.map((member: CareTeamMember) => (
                <div key={`${member.name}-${member.role}`} className="rounded-lg bg-gray-50 p-3 text-sm text-gray-800">
                  <div className="font-medium">{member.name}</div>
                  <div className="text-gray-500">{member.role}</div>
                </div>
              ))}
            </div>
          </section>
        </div>

        <div className="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Recent incidents</h2>
              <AlertTriangle className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 space-y-3">
              {filteredIncidents.length === 0 ? (
                <div className="rounded-lg bg-gray-50 p-4 text-sm text-gray-600">No matches.</div>
              ) : (
                filteredIncidents.map((i) => (
                  <div key={`${i.title}-${i.date}`} className="rounded-lg bg-gray-50 p-4">
                    <div className="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                      <p className="font-medium text-gray-900">{i.title}</p>
                      <p className="text-sm text-gray-600">{formatDate(i.date)}</p>
                    </div>
                    <p className="mt-2 text-sm text-gray-600">{i.notes}</p>
                  </div>
                ))
              )}
            </div>
          </section>

          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Labs</h2>
              <FileText className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 space-y-3">
              {filteredLabs.length === 0 ? (
                <div className="rounded-lg bg-gray-50 p-4 text-sm text-gray-600">No matches.</div>
              ) : (
                filteredLabs.map((l) => (
                  <div key={`${l.name}-${l.date}`} className="rounded-lg bg-gray-50 p-4">
                    <div className="flex items-start justify-between gap-4">
                      <div>
                        <p className="font-medium text-gray-900">{l.name}</p>
                        <p className="mt-1 text-sm text-gray-600">
                          {l.result} <span className="text-gray-400">(ref {l.range})</span>
                        </p>
                        <p className="mt-1 text-xs text-gray-500">{formatDate(l.date)}</p>
                      </div>
                      <span
                        className={
                          l.status === 'High'
                            ? 'rounded-full bg-rose-50 px-3 py-1 text-xs font-medium text-rose-700'
                            : 'rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700'
                        }
                      >
                        {l.status}
                      </span>
                    </div>
                  </div>
                ))
              )}
            </div>
          </section>
        </div>

        <div className="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Upcoming appointments</h2>
              <Calendar className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 space-y-3">
              {appointments.map((a) => (
                <div key={`${a.when.getTime()}`} className="rounded-lg bg-gray-50 p-4">
                  <div className="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <p className="font-medium text-gray-900">{a.type}</p>
                    <p className="text-sm text-gray-600">{formatAppointmentDate(a.when)}</p>
                  </div>
                  <p className="mt-1 text-sm text-gray-600">{a.location}</p>
                  <p className="mt-2 text-sm text-gray-500">Prep: {a.prep}</p>
                </div>
              ))}
            </div>
          </section>

          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Medications</h2>
              <Pill className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 space-y-3">
              {filteredMeds.map((m) => (
                <div key={m.name} className="rounded-lg bg-gray-50 p-4">
                  <div className="flex items-start justify-between gap-4">
                    <div>
                      <p className="font-medium text-gray-900">{m.name}</p>
                      <p className="mt-1 text-sm text-gray-600">
                        {m.dose} · {m.schedule}
                      </p>
                      <p className="mt-1 text-sm text-gray-500">For: {m.indication}</p>
                    </div>
                    <div className="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
                      <CheckCircle2 className="h-4 w-4" />
                      {m.status}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    );
  }

  function CaregiverSummary() {
    return (
      <div className="flex-1 overflow-y-auto overscroll-contain p-6 md:p-10">
        <div className="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <div className="inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-indigo-700">
              <Shield className="h-4 w-4" />
              <span className="text-sm font-medium">Caregiver Summary View</span>
            </div>
            <h1 className="mt-3 text-3xl font-bold text-gray-900">Health Dashboard</h1>
            <p className="mt-1 text-gray-600">
              {caregiver.name} ({caregiver.relation}) viewing {patient.name} (age {patient.age})
            </p>
            <p className="mt-1 text-sm text-gray-500">{caregiver.access}</p>
          </div>

          <div className="flex flex-col gap-2 sm:flex-row sm:items-center">
            <ViewModeToggle />
            <div className="flex items-center gap-2 rounded-lg bg-white px-3 py-2 shadow-sm ring-1 ring-gray-200">
              <input
                value={query}
                onChange={(e) => setQuery(e.target.value)}
                placeholder="Search..."
                className="w-full border-0 bg-transparent text-sm text-gray-900 placeholder-gray-500 focus:ring-0"
              />
            </div>
            <div className="flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm text-gray-700 shadow-sm ring-1 ring-gray-200">
              <select
                value={selectedYear}
                onChange={(e) => setSelectedYear(Number(e.target.value))}
                className="border-0 bg-transparent text-sm text-gray-900 focus:ring-0"
              >
                {years.map(year => (
                  <option key={year} value={year}>{year}</option>
                ))}
              </select>
              <select
                value={selectedMonth ?? ''}
                onChange={(e) => setSelectedMonth(e.target.value ? Number(e.target.value) : null)}
                className="border-0 bg-transparent text-sm text-gray-900 focus:ring-0"
              >
                <option value="">All Months</option>
                {months.map(month => (
                  <option key={month.value} value={month.value}>
                    {month.label}
                  </option>
                ))}
              </select>
            </div>
            <label className="flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-sm text-gray-700 shadow-sm ring-1 ring-gray-200">
              <input
                type="checkbox"
                checked={onlyNeuro}
                onChange={(e) => setOnlyNeuro(e.target.checked)}
                className="h-4 w-4"
              />
              Show neuro-related only
            </label>
          </div>
        </div>

        <div className="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
          <div className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-start justify-between">
              <div>
                <p className="text-sm font-medium text-gray-500">Primary concern</p>
                <p className="mt-1 text-lg font-semibold text-gray-900">{patient.primaryConcern}</p>
              </div>
              <Activity className="h-5 w-5 text-indigo-600" />
            </div>
            <div className="mt-4">
              <p className="text-sm text-gray-600">
                <span className="font-medium text-gray-900">Status:</span> {summary.stability}
              </p>
              <p className="mt-1 text-sm text-gray-500">Last updated: {summary.lastUpdated}</p>
            </div>
          </div>

          <div className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-start justify-between">
              <div>
                <p className="text-sm font-medium text-gray-500">Care team</p>
                <div className="mt-2 space-y-1">
                  {patient.careTeam.map((member: CareTeamMember) => (
                    <p key={`${member.name}-${member.role}`} className="text-sm text-gray-800">
                      {member.name} ({member.role})
                    </p>
                  ))}
                </div>
              </div>
              <User className="h-5 w-5 text-indigo-600" />
            </div>
          </div>

          <div className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-start justify-between">
              <div>
                <p className="text-sm font-medium text-gray-500">When to seek urgent help</p>
                <div className="mt-2 space-y-1">
                  {summary.redFlags.map((f) => (
                    <div key={f} className="flex items-start gap-2 text-sm text-gray-800">
                      <AlertTriangle className="mt-0.5 h-4 w-4 text-amber-600" />
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div className="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Upcoming appointments</h2>
              <Calendar className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 space-y-3">
              {appointments.map((a) => (
                <div key={`${a.when.getTime()}`} className="rounded-lg bg-gray-50 p-4">
                  <div className="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <p className="font-medium text-gray-900">{a.type}</p>
                    <p className="text-sm text-gray-600">{formatAppointmentDate(a.when)}</p>
                  </div>
                  <p className="mt-1 text-sm text-gray-600">{a.location}</p>
                  <p className="mt-2 text-sm text-gray-500">Prep: {a.prep}</p>
                </div>
              ))}
            </div>
          </section>

          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold text-gray-900">Medications</h2>
              <Pill className="h-5 w-5 text-gray-500" />
            </div>
            <div className="mt-4 space-y-3">
              {filteredMeds.map((m) => (
                <div key={m.name} className="rounded-lg bg-gray-50 p-4">
                  <div className="flex items-start justify-between gap-4">
                    <div>
                      <p className="font-medium text-gray-900">{m.name}</p>
                      <p className="mt-1 text-sm text-gray-600">
                        {m.dose} · {m.schedule}
                      </p>
                      <p className="mt-1 text-sm text-gray-500">For: {m.indication}</p>
                    </div>
                    <span className="rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
                      {m.status}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>

        <div className="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <h2 className="text-lg font-semibold text-gray-900">Recent incidents</h2>
            <p className="mt-1 text-sm text-gray-500">Symptom and event log (for caregiver awareness)</p>
            <div className="mt-4 space-y-3">
              {filteredIncidents.length === 0 ? (
                <div className="rounded-lg bg-gray-50 p-4 text-sm text-gray-600">No matches.</div>
              ) : (
                filteredIncidents.map((i) => (
                  <div key={`${i.title}-${i.date}`} className="rounded-lg bg-gray-50 p-4">
                    <div className="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                      <p className="font-medium text-gray-900">{i.title}</p>
                      <p className="text-sm text-gray-600">{i.date}</p>
                    </div>
                    <div className="mt-1 flex items-center gap-2">
                      <span
                        className={
                          i.severity === 'Moderate'
                            ? 'rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700'
                            : 'rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700'
                        }
                      >
                        {i.severity}
                      </span>
                      <span className="text-xs text-gray-500">{i.tag === 'neuro' ? 'Neuro' : 'General'}</span>
                    </div>
                    <p className="mt-2 text-sm text-gray-600">{i.notes}</p>
                  </div>
                ))
              )}
            </div>
          </section>

          <section className="rounded-xl bg-white p-5 shadow-sm ring-1 ring-gray-200">
            <h2 className="text-lg font-semibold text-gray-900">Labs</h2>
            <p className="mt-1 text-sm text-gray-500">Most recent results relevant to inflammation / neuro monitoring</p>
            <div className="mt-4 space-y-3">
              {filteredLabs.length === 0 ? (
                <div className="rounded-lg bg-gray-50 p-4 text-sm text-gray-600">No matches.</div>
              ) : (
                filteredLabs.map((l) => (
                  <div key={`${l.name}-${l.date}`} className="rounded-lg bg-gray-50 p-4">
                    <div className="flex items-start justify-between gap-4">
                      <div>
                        <p className="font-medium text-gray-900">{l.name}</p>
                        <p className="mt-1 text-sm text-gray-600">
                          {l.result} <span className="text-gray-400">(ref {l.range})</span>
                        </p>
                        <p className="mt-1 text-xs text-gray-500">{l.date}</p>
                      </div>
                      <span
                        className={
                          l.status === 'High'
                            ? 'rounded-full bg-rose-50 px-3 py-1 text-xs font-medium text-rose-700'
                            : 'rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700'
                        }
                      >
                        {l.status}
                      </span>
                    </div>
                  </div>
                ))
              )}
            </div>
          </section>
        </div>
      </div>
    );
  }

  return viewMode === 'classic' ? <Dashboard /> : <CaregiverSummary />;
}
