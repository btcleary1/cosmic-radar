'use client';

import { useState, useEffect } from 'react';
import {
  Activity,
  AlertTriangle,
  Calendar,
  CheckCircle2,
  FileText,
  Pill,
  Shield,
  User,
} from 'lucide-react';

// Define types for the data we'll be using
interface Medication {
  id: string;
  name: string;
  dosage: string;
  frequency: string;
  prescribedBy: string;
  status: string;
  startDate: string;
  endDate?: string;
  tag?: string;
}

interface Appointment {
  id: string;
  type: string;
  date: Date;
  provider: string;
  location: string;
  notes: string;
  tag?: string;
  prep?: string;
}

interface LabResult {
  id: string;
  test: string;
  date: Date;
  result: string;
  status: string;
  notes: string;
}

interface Incident {
  id: string;
  type: string;
  date: Date;
  severity: string;
  notes: string;
  actionTaken: string;
}

type ViewMode = 'classic' | 'caregiver';

interface CareTeamMember {
  name: string;
  role: string;
}

interface Patient {
  name: string;
  age: number;
  primaryConcern: string;
  lastVisit: string;
  nextAppointment: string;
  careTeam: CareTeamMember[];
}

interface Summary {
  stability: string;
  lastUpdated: string;
  redFlags: string[];
}

// Static data
const PATIENT: Patient = {
  name: 'Ethan Alvarez',
  age: 12,
  primaryConcern: 'Neuroinflammatory condition with cardiac involvement',
  lastVisit: '2 weeks ago',
  nextAppointment: 'In 2 weeks',
  careTeam: [
    { name: 'Dr. S. Patel', role: 'Neurologist' },
    { name: 'Dr. A. Nguyen', role: 'Pediatrician' },
  ],
